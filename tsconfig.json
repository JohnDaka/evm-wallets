{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2020",
    "lib": ["es2022", "dom"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    // Specs run as TypeScript straight in Node, which needs a relative import to name its file:
    // `./ethereum-wallet.ts`. The build turns that into `./ethereum-wallet.js`.
    "rewriteRelativeImportExtensions": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "src/**/*.spec.ts"]
}

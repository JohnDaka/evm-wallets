{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2020",
    "lib": ["es2022", "dom"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    // Specs run as TypeScript straight in Node, which needs a relative import to name its file:
    // `./ethereum-wallet.ts`. The build turns that into `./ethereum-wallet.js`.
    "rewriteRelativeImportExtensions": true,
    // Node runs them by stripping the types away, which leaves no room for TypeScript that emits
    // code (an enum, a constructor parameter property): the typecheck refuses it, not the test run.
    "erasableSyntaxOnly": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "types": ["node"]
  },
  // Everything, specs too: what `typecheck`, the editor and the linter see.
  "include": ["src/**/*.ts"]
}
